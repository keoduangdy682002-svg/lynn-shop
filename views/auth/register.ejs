<div class="form-card">
  <h2 style="text-align:center;">ສະໝັກສະມາຊິກ</h2>
  <% if (error) { %><div class="form-error"><%= error %></div><% } %>
  <form action="/auth/register" method="POST">
    <div class="form-group"><label>ຊື່ ແລະ ນາມສະກຸນ</label><input name="full_name" required></div>
    <div class="form-group"><label>ອີເມວ</label><input type="email" name="email" required></div>
    <div class="form-group"><label>ເບີໂທ</label><input name="phone"></div>
    <div class="form-group"><label>ລະຫັດຜ່ານ</label><input type="password" name="password" minlength="6" required></div>
    <button type="submit" class="btn btn-gold btn-block">ສະໝັກສະມາຊິກ</button>
  </form>
  <div class="form-note">ມີບັນຊີແລ້ວ? <a href="/auth/login">ເຂົ້າສູ່ລະບົບ</a></div>
</div>
