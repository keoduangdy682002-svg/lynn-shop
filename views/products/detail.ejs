<div class="container product-page-grid">

  <!-- ==== ຖັນຫລັກ: gallery + ຂໍ້ມູນສິນຄ້າ + ລີວິວ ==== -->
  <div>
    <div class="product-detail" style="padding:0;">
      <div>
        <div class="gallery-main">
          <img id="mainImg" src="<%= product.product_images[0] ? product.product_images[0].image_url : 'https://placehold.co/500x500' %>" alt="<%= product.name %>">
        </div>
        <div class="gallery-thumbs">
          <% product.product_images.forEach(img => { %>
            <img src="<%= img.image_url %>" onclick="document.getElementById('mainImg').src=this.src">
          <% }) %>
        </div>

        <% const variantsWithImg = product.product_variants.filter(v => v.image_url); %>
        <% if (variantsWithImg.length) { %>
          <div style="margin-top:16px;">
            <div class="product-meta" style="margin-bottom:8px;">ເລືອກສີ / ຕົວເລືອກ:</div>
            <div class="gallery-thumbs" style="flex-wrap:wrap;">
              <% variantsWithImg.forEach(v => { %>
                <img src="<%= v.image_url %>" title="<%= v.name %>"
                     class="variant-swatch" data-variant-id="<%= v.id %>"
                     onclick="selectVariant('<%= v.id %>', this.src)">
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>

      <div>
        <h1 class="pd-title"><%= product.name %></h1>
        <div class="product-meta">⭐ <%= product.rating_avg || 0 %> (<%= product.rating_count || 0 %> ລີວິວ) · ຂາຍແລ້ວ <%= product.sold_count || 0 %></div>
        <div class="pd-price">
          ₭<%= Number(product.price).toLocaleString() %>
          <% if (product.compare_price) { %><span class="price-old" style="font-size:16px;">₭<%= Number(product.compare_price).toLocaleString() %></span><% } %>
        </div>
        <div class="pd-stock"><%= product.stock > 0 ? `ມີສິນຄ້າ ${product.stock} ຊິ້ນ` : 'ສິນຄ້າໝົດ' %></div>

        <p><%= product.description %></p>

        <form action="/cart/add" method="POST" id="addToCartForm">
          <input type="hidden" name="product_id" value="<%= product.id %>">
          <% if (product.product_variants && product.product_variants.length) { %>
            <div class="form-group">
              <label>ເລືອກຕົວເລືອກ</label>
              <select name="variant_id" id="variantSelect">
                <% product.product_variants.forEach(v => { %>
                  <option value="<%= v.id %>" data-image="<%= v.image_url || '' %>">
                    <%= v.name %> <%= v.extra_price > 0 ? `(+₭${v.extra_price})` : '' %>
                  </option>
                <% }) %>
              </select>
            </div>
          <% } %>
          <div class="qty-box">
            <label>ຈຳນວນ:</label>
            <input type="number" name="quantity" value="1" min="1" max="<%= product.stock %>">
          </div>
          <div class="pd-actions">
            <button type="submit" class="btn btn-gold" <%= product.stock <= 0 ? 'disabled' : '' %>>ເພີ່ມໃສ່ກະຕ່າ</button>
            <a href="/orders/checkout" class="btn btn-outline">ຊື້ເລີຍ</a>
          </div>
        </form>
      </div>
    </div>

    <div class="section">
      <h2>ລີວິວຈາກລູກຄ້າ</h2>
      <% if (reviews.length === 0) { %>
        <p style="color:#777;">ຍັງບໍ່ທັນມີລີວິວ</p>
      <% } %>
      <% reviews.forEach(r => { %>
        <div style="border-bottom:1px solid var(--line);padding:14px 0;">
          <strong><%= r.profiles?.full_name || 'ລູກຄ້າ' %></strong> — ⭐<%= r.rating %>
          <p style="margin:6px 0 0;"><%= r.comment %></p>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- ==== Sidebar ຂວາ: ສິນຄ້າແນະນຳໃນໝວດດຽວກັນ ==== -->
  <aside class="product-sidebar">
    <h3 style="font-size:17px;">ສິນຄ້າແນະນຳ</h3>
    <% if (related.length === 0) { %>
      <p class="product-meta">ບໍ່ມີສິນຄ້າອື່ນໃນໝວດນີ້</p>
    <% } %>
    <% related.forEach(p => { %>
      <a href="/products/<%= p.slug %>" style="display:flex;gap:10px;margin-bottom:14px;align-items:center;">
        <img src="<%= p.product_images?.[0]?.image_url || 'https://placehold.co/60x60' %>"
             style="width:60px;height:60px;object-fit:cover;border-radius:8px;flex-shrink:0;">
        <div>
          <div style="font-size:13.5px;color:var(--bark);line-height:1.3;"><%= p.name %></div>
          <div class="price-now" style="font-size:14px;">₭<%= Number(p.price).toLocaleString() %></div>
        </div>
      </a>
    <% }) %>
  </aside>
</div>

<script>
  // ກົດຮູບຕົວເລືອກ (variant) -> ປ່ຽນຮູບຫລັກ + ເລືອກໃນ dropdown ໃຫ້ກົງກັນ
  function selectVariant(variantId, imgSrc) {
    document.getElementById('mainImg').src = imgSrc;
    const select = document.getElementById('variantSelect');
    if (select) select.value = variantId;
    document.querySelectorAll('.variant-swatch').forEach(el => {
      el.style.borderColor = el.dataset.variantId === variantId ? 'var(--forest)' : 'var(--line)';
      el.style.borderWidth = el.dataset.variantId === variantId ? '2px' : '1px';
    });
  }
  // ຖ້າປ່ຽນຈາກ dropdown ໂດຍກົງ, ໃຫ້ປ່ຽນຮູບຫລັກນຳ (ຖ້າ variant ນັ້ນມີຮູບ)
  document.getElementById('variantSelect')?.addEventListener('change', function () {
    const opt = this.options[this.selectedIndex];
    if (opt.dataset.image) document.getElementById('mainImg').src = opt.dataset.image;
  });
</script>
