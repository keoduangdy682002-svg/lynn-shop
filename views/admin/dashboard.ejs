<div class="admin-layout">
  <%- include('../partials/admin-sidebar') %>
  <div class="admin-main">
    <h1>Dashboard</h1>
    <div class="stat-cards">
      <div class="stat-card"><div class="num"><%= productCount %></div><div class="label">ສິນຄ້າທັງໝົດ</div></div>
      <div class="stat-card"><div class="num"><%= orderCount %></div><div class="label">ອໍເດີທັງໝົດ</div></div>
      <div class="stat-card"><div class="num"><%= userCount %></div><div class="label">ສະມາຊິກ</div></div>
    </div>

    <h2>ອໍເດີຫລ້າສຸດ</h2>
    <div class="table-scroll">
    <table class="data-table">
      <thead><tr><th>ເລກອໍເດີ</th><th>ຍອດລວມ</th><th>ສະຖານະ</th><th>ວັນທີ</th></tr></thead>
      <tbody>
        <% recentOrders.forEach(o => { %>
          <tr>
            <td><%= o.order_no %></td>
            <td>₭<%= Number(o.total).toLocaleString() %></td>
            <td><span class="badge badge-<%= o.status %>"><%= o.status %></span></td>
            <td><%= new Date(o.created_at).toLocaleDateString('lo-LA') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  </div>
</div>
