<div class="admin-layout">
  <%- include('../partials/admin-sidebar') %>
  <div class="admin-main">
    <h1>ຈັດການອໍເດີ</h1>
    <div style="overflow-x:auto;">
    <table class="data-table">
      <thead><tr><th>ເລກອໍເດີ</th><th>ລູກຄ້າ</th><th>ຍອດລວມ</th><th>ສະຖານະ</th><th>ອັບເດດ / ແນບບິນ</th></tr></thead>
      <tbody>
        <% orders.forEach(o => { %>
          <tr>
            <td>
              <%= o.order_no %><br>
              <a href="/admin/orders/<%= o.id %>" style="font-size:12px;">📄 ເບິ່ງບິນເຕັມ →</a>
            </td>
            <td><%= o.profiles?.full_name || '-' %><br><span class="product-meta"><%= o.profiles?.phone || '' %></span></td>
            <td>₭<%= Number(o.total).toLocaleString() %></td>
            <td>
              <span class="badge badge-<%= o.status %>"><%= o.status %></span>
              <% if (o.shipping_proof_url) { %>
                <br><a href="<%= o.shipping_proof_url %>" target="_blank" style="font-size:12px;">📎 ເບິ່ງບິນທີ່ແນບໄວ້</a>
              <% } %>
            </td>
            <td>
              <form action="/admin/orders/<%= o.id %>/status" method="POST" enctype="multipart/form-data"
                    style="display:flex;flex-direction:column;gap:6px;min-width:220px;">
                <select name="status">
                  <% ['pending','paid','processing','shipped','delivered','cancelled','refunded'].forEach(s => { %>
                    <option value="<%= s %>" <%= o.status === s ? 'selected' : '' %>><%= s %></option>
                  <% }) %>
                </select>
                <input type="text" name="tracking_number" placeholder="ເລກ tracking (ຖ້າມີ)" value="<%= o.tracking_number || '' %>" style="padding:6px 8px;font-size:13px;">
                <label style="font-size:12px;color:#777;">📎 ແນບບິນຝາກເຄື່ອງ (ຮູບ, ຖ້າມີ)</label>
                <input type="file" name="shipping_proof" accept="image/*" style="font-size:12px;">
                <button type="submit" class="btn btn-gold btn-sm">ບັນທຶກ</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  </div>
</div>
